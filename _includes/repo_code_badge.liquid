{%- if include.href -%}
<a href="{{ include.href }}" class="btn btn-sm z-depth-0" role="button"{% if include.aria_label %} aria-label="{{ include.aria_label }}"{% endif %}>Code</a>
{%- else -%}
<span class="btn btn-sm z-depth-0"{% if include.aria_label %} aria-label="{{ include.aria_label }}"{% else %} aria-hidden="true"{% endif %}>Code</span>
{%- endif -%}